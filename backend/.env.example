# ==============================================================================
# AgroGenius AI - Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the backend service.
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Server & Network Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://agrogenius-ai.vercel.app"]

# PostgreSQL Database Configuration
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agrogenius_db

# Cryptography & JWT Authentication
# Generate a strong 256-bit random key in production (e.g., openssl rand -hex 32)
JWT_SECRET_KEY=dev_placeholder_jwt_secret_key_change_in_production_32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Machine Learning Artifact Paths
ML_MODEL_PATH=../ml-service/models/crop_recommendation_model.joblib
ML_METADATA_PATH=../ml-service/models/model_metadata.json

# External Meteorological Services (Open-Meteo)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_TTL_SECONDS=1800
